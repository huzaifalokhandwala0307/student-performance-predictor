   "source": [
    "import numpy as np\n",
    "\n",
    "y_t = np.array([2,5,6,8,7])\n",
    "y_p = np.array([1.5,4.7,5.91,8.01,7.5])\n",
    "\n",
    "mae = np.mean(np.abs(y_t,y_p))\n",
    "mse = np.mean((y_t - y_p)**2)\n",
    "rmse = np.sqrt(mse)\n",
    "mape = np.mean(np.abs((y_t - y_p)/y_t))*100\n",
    "\n",
    "print(mae)\n",
    "print(mse)\n",
    "print(rmse)\n",
    "print(mape)"
   ]
  },
